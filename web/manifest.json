{
  "name": "Optimizer for Boox Notes",
  "short_name": "Note Optimizer",
  "description": "Optimize Boox .note files by removing redundant stroke data",
  "start_url": ".",
  "display": "standalone",
  "background_color": "#f3f4f6",
  "theme_color": "#ffffff",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/octet-stream": [".note"]
      }
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/octet-stream",
            "application/zip",
            "application/x-zip-compressed",
            "application/x-zip",
            "*/*",
            ".note"
          ]
        }
      ]
    }
  }
}
